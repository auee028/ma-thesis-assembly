{
    "env": {
        "env_name": "Assembly2",
        "robots": "UR5e",
        "has_renderer": false,
        "has_offscreen_renderer": true,
        "use_camera_obs": true,
        "camera_heights": 256,
        "camera_widths": 256,
        "camera_names": ["frontview", "birdview", "agentview", "sideview"],
        "camera_depths": ["frontview", "birdview", "agentview", "sideview"],
        "camera_segmentations": "element",
        "hard_reset": false,
        "mujoco_passive_viewer": true,
        "horizon": 5000
    },
    "task": {
        "target_query_structure": "assembly the blocks on the frame",
        "target_cam": "agentview",
        "target_rgb_dir": "../tmp",
        "target_rgb_path": "../tmp/obs_rgb_init.png",
        "target_depth_path": "",
        "target_seg_path": ""
    },
    "llm": {
        "api_keys": {
            "openai": "",
            "mistral": "",
            "google": "AQ.Ab8RN6LvBL8ilLUq008ER1Q5C9ksx5H1oeic6XDxKGOJmJleRA"
        },
        "model_config": {
            "provider": "google",
            "model": "gemini-2.5-flash",
            "top_p": 0.8
        },
        "token_log_dir": "./token_usage"
    },
    "relation": {
        "dist_mode": false,
        "prim_prompt_files": {
            "system_prompt": "../prompts/system_prompt_fmb_relation_primitives.txt",
            "examples_prompt": "../prompts/examples_prompt.txt",
            "example_rgb_paths": "../prompts/example_image_paths_rgb.txt",
            "example_depth_paths": "",
